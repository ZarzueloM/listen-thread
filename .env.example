# Speechify TTS API Key (optional, recommended)
# When set, Speechify is used as the primary TTS engine (voices: carlos / carmen).
# Get your API key at https://speechify.com or from the Speechify API dashboard.
# SPEECHIFY_API_KEY=your_api_key_here

# Google Cloud TTS Credentials (optional, fallback when Speechify is not configured)
# If not set, the app will use espeak/ffmpeg as fallback
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Server Port
PORT=3000

# Audio cleanup: delete merged MP3 files older than N hours (0 = disabled). Default: 24
# AUDIO_MAX_AGE_HOURS=24
# Grace period: never delete files newer than N minutes (avoids deleting while playing). Default: 15
# AUDIO_MIN_AGE_MINUTES=15
